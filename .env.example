########################################
# Database
########################################

# MongoDB connection URI
# Example:
# mongodb://localhost:27017/pcss
MONGODB_URI=

########################################
# Server
########################################

# Server bind IP
# Example: 127.0.0.1
SERVER_IP=127.0.0.1

# Server port
# Example: 8089
SERVER_PORT=8089

# Public base URL of this server
# Example: http://127.0.0.1:8089
URL_BASE=

########################################
# Custom LLM / API
########################################

# Base URL of custom API (LLM backend)
# Example: http://localhost:8001
CUSTOM_API_URL=

# Authentication token for custom API
CUSTOM_TOKEN=

########################################
# LLM Settings
########################################

# LLM name source
# Example values:
# - openai
# - custom
# - local
LLM_NAME_SOURCE=

# Enable/disable name score cache
# true | false
NAME_CACHE=true

########################################
# Access Control
########################################

# Require login for non-internal IPs
# true | false
ENABLE_ACCESS_CONTROL=true

# Block IPs that probe for suspicious paths (.env, .git, wp-config, etc.)
# true | false
ENABLE_IP_BLOCKER=true

# Only this email domain may sign up (verified by an emailed OTP code)
# Example: postech.ac.kr
ALLOWED_EMAIL_DOMAIN=postech.ac.kr

# Secret used to sign session cookies and hash OTP codes.
# MUST be set to a long random value in production.
SUB_AUTH_SECRET=

########################################
# Mail Sending
########################################

# Which SMTP path to send through.
#   gmail   - smtp.gmail.com:587 with an app password (app/data/mail_lock.json,
#             or MAIL_SENDER + MAIL_PASSWORD below). Works from anywhere.
#   postech - smtp.postech.ac.kr:25 unauthenticated relay. NO login required,
#             but ONLY works from an IP registered with the POSTECH mail admin
#             via '이메일 무인증 발송신청'. Registered IP: 141.223.145.21
#             (= pcss.postech.ac.kr). From any other IP the server answers
#             '421 4.3.2 Service not available'.
MAIL_BACKEND=gmail

# Sender address.
#   postech backend: the From address (any @postech.ac.kr address is accepted)
#   gmail backend:   optional override of mail_lock.json, needs MAIL_PASSWORD too
MAIL_SENDER=pcss@postech.ac.kr

# Gmail app password. Only used by the gmail backend, and only when MAIL_SENDER
# is also set; otherwise app/data/mail_lock.json is used.
MAIL_PASSWORD=

# Display name shown to recipients, and an optional Reply-To address
# (the postech relay is send-only, so point replies at a real mailbox).
MAIL_SENDER_NAME=PCSS
MAIL_REPLY_TO=

# postech backend only - override if the relay host/port ever changes
MAIL_SMTP_HOST=smtp.postech.ac.kr
MAIL_SMTP_PORT=25
MAIL_STARTTLS=true

########################################
# Crawler Settings
########################################

# Force crawl from web even if local cache exists
# true | false
FORCE_CRAWL=false
